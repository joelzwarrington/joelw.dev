---
---

<button type="button" class="toggle" id="theme-toggle" aria-label="Switch theme">
  <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.5v3M12 18.5v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2.5 12h3M18.5 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"></path>
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .toggle {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: transparent;
    color: var(--fg);
    display: grid;
    place-items: center;
    cursor: pointer;
    flex: none;
  }
  .toggle:hover,
  .toggle:focus-visible {
    background: var(--fg);
    color: var(--bg);
  }
  .toggle:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .toggle {
      transition: background-color 0.2s ease, color 0.2s ease;
    }
  }
  .toggle .icon {
    grid-area: 1 / 1;
    width: 1.15rem;
    height: 1.15rem;
    opacity: 0;
    transform: rotate(70deg) scale(0.4);
  }
  /* Icon shows the theme a click will switch *to*, not the current one.
     Keyed off html[data-theme] (set synchronously in Base.astro's head
     script, same as tokens.css) rather than JS-set state on this button,
     so the correct icon paints on first frame instead of flashing. */
  .toggle .icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  :global(html[data-theme='dark']) .toggle .icon-moon {
    opacity: 0;
    transform: rotate(70deg) scale(0.4);
  }
  :global(html[data-theme='dark']) .toggle .icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .toggle .icon-moon {
      opacity: 0;
      transform: rotate(70deg) scale(0.4);
    }
    :global(html:not([data-theme='light'])) .toggle .icon-sun {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .toggle .icon {
      transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle') as HTMLButtonElement;

  function stored(): 'light' | 'dark' | null {
    try {
      const value = localStorage.getItem('theme');
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function systemPrefersDark() {
    return window.matchMedia?.('(prefers-color-scheme: dark)').matches;
  }

  function resolved(): 'light' | 'dark' {
    return stored() ?? (systemPrefersDark() ? 'dark' : 'light');
  }

  function paint(theme: 'light' | 'dark') {
    btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  }

  function setTheme(next: 'light' | 'dark', evt?: MouseEvent) {
    const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

    function apply() {
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* ignore */
      }
      if (next === 'light') root.setAttribute('data-theme', 'light');
      else root.setAttribute('data-theme', 'dark');
      paint(next);
    }

    if (!document.startViewTransition || reduceMotion || !evt) {
      apply();
      return;
    }

    const x = evt.clientX;
    const y = evt.clientY;
    const endRadius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const transition = document.startViewTransition(apply);
    transition.ready.then(() => {
      root.animate(
        {
          clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`],
        },
        { duration: 550, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' }
      );
    });
  }

  btn.addEventListener('click', (evt) => setTheme(resolved() === 'dark' ? 'light' : 'dark', evt));
  paint(resolved());
</script>
