---
import { getCollection } from 'astro:content';
import ProjectEntry from './ProjectEntry.astro';

const projects = (await getCollection('projects')).sort((a, b) => Number(b.data.highlighted) - Number(a.data.highlighted));
---

<section class="block" id="projects">
  <h2 class="section-title"><a class="pilcrow" href="#projects" aria-label="Link to this section">¶</a>Projects</h2>

  <ul class="projects">
    {
      projects.map((project) => (
        <li class="project-item">
          <ProjectEntry project={project} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .block {
    max-width: var(--col);
    margin: 5rem auto 0;
    padding: 0 1.5rem;
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project-item + .project-item {
    margin-top: 2.5rem;
  }
</style>
